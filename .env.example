# ==========================================
# BACK (.env) 예시 템플릿
# ==========================================
# 규칙:
# - URL/도메인 설정은 app/core/config.py(Settings) 기준으로 읽습니다.
# - Docker Compose 실행 시 일부 값은 루트 docker-compose.yaml에서 override될 수 있습니다.
# - [필수] / [선택] / [조건부 필수] 라벨을 확인하세요.

# ------------------------------------------
# 기본 앱 설정
# ------------------------------------------
# [선택] 서비스 이름 (로그/문서 표시용)
PROJECT_NAME=Avatar Forge Backend

# [선택] API prefix
API_V1_STR=/api

# [필수] 데이터베이스 연결 문자열
# 로컬 SQLite 예시
DATABASE_URL=sqlite+aiosqlite:///./avatar_forge.db

# [필수] JWT 서명 비밀키 (운영에서 반드시 강한 랜덤 문자열로 변경)
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# [선택] JWT 알고리즘 (기본 HS256)
ALGORITHM=HS256

# [선택] Access token 만료 분 (기본 7일 = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------
# CORS / 프론트 주소 / 공개 주소
# ------------------------------------------
# [필수] 프론트엔드 기본 주소 (OAuth 완료 후 리다이렉트 등에 사용)
FRONTEND_URL=http://localhost:3000

# [선택] 백엔드 공개 주소(문서/운영 정리용)
# 현재 필수는 아니며 비워둬도 동작합니다.
BACKEND_PUBLIC_URL=

# [필수] CORS 허용 origin 목록
# 형식1(JSON 배열 권장): ["http://localhost:3000","https://app.example.com"]
# 형식2(쉼표구분): http://localhost:3000,https://app.example.com
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ------------------------------------------
# Google OAuth / 인증
# ------------------------------------------
# [조건부 필수] Google 로그인 기능 사용 시 필요
GOOGLE_CLIENT_ID=

# [조건부 필수] Google 로그인 기능 사용 시 필요
GOOGLE_CLIENT_SECRET=

# [조건부 필수] Google 로그인 기능 사용 시 필요
# Google Cloud Console에 등록한 콜백 URL과 정확히 일치해야 합니다.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# [선택/보안 플래그] Google OAuth에서 HTTP(비HTTPS) 리다이렉트를 허용할지 여부
# 로컬 개발 편의 때문에 기본값 true를 유지하지만, 운영 HTTPS 환경에서는 false 권장
GOOGLE_SSO_ALLOW_INSECURE_HTTP=true

# [선택/보안 플래그] 인증 쿠키 이름 (일반적으로 기본값 유지)
AUTH_COOKIE_NAME=access_token

# [선택/보안 플래그] 인증 쿠키 Secure 속성
# 로컬 HTTP 개발: false / 운영 HTTPS: true 권장
AUTH_COOKIE_SECURE=false

# [선택/보안 플래그] 인증 쿠키 SameSite 정책 (lax|strict|none)
AUTH_COOKIE_SAMESITE=lax

# [선택/보안 플래그] 토큰 검증 실패 시 dev-user 폴백 허용 여부
# 로컬 개발 편의를 위해 기본값 true 유지. 운영에서는 false 권장.
DEV_AUTH_FALLBACK_ENABLED=true

# [선택/보안 플래그] startup 시 환경/설정 검증을 엄격하게 할지 여부 (1차 기본값은 warn-only)
STRICT_STARTUP_VALIDATION=false

# [선택/운영 플래그] startup ad-hoc schema patch 실행 여부 (레거시 DB 호환용)
# 향후 Alembic 등으로 대체 전까지 기본값 true 유지
STARTUP_SCHEMA_PATCH_ENABLED=true

# ------------------------------------------
# AI API Keys
# ------------------------------------------
# [조건부 필수] 백엔드에서 Gemini 호출 기능 사용 시 권장 키
# 보안 정책: Gemini 비밀키는 Backend .env에서만 관리합니다.
# (FRONT의 NEXT_PUBLIC_*에는 절대 넣지 않음)
GEMINI_API_KEY=

# [선택] Backend에서 Gemini 호출 시 사용할 기본 모델명
# 예: gemini-2.5-flash / gemini-2.5-pro
# 미설정 시 기본값: gemini-2.5-flash
GOOGLE_API_MODEL=gemini-2.5-flash

# [선택] OpenAI 기능 사용 시
OPENAI_API_KEY=

# [선택(legacy alias)] 기존 환경 호환용 별칭
# 신규 설정은 GEMINI_API_KEY 사용을 권장합니다.
GOOGLE_API_KEY=

# [선택] Gemini Safety 필터 강도 (google-generativeai HarmBlockThreshold 이름)
# 허용값:
# - BLOCK_NONE: 위해성 있는 문장도 거르지 않음 (가장 완화)
# - BLOCK_ONLY_HIGH: 높은 위해성만 차단
# - BLOCK_MEDIUM_AND_ABOVE: 중간 이상 위해성 차단
# - BLOCK_LOW_AND_ABOVE: 조금이라도 위해성이 있으면 차단 (가장 엄격)
# - HARM_BLOCK_THRESHOLD_UNSPECIFIED: SDK 기본값 사용
# 현재 기본 동작 호환을 위해 기본값은 BLOCK_NONE으로 둡니다.
GOOGLE_SAFETY_THRESHOLD=BLOCK_NONE



# ------------------------------------------
# LLM 서비스 설정 (Ollama / vLLM)
# ------------------------------------------
# [선택] 현재 구현 기본값은 ollama
# 가능한 값 예시: ollama
LLM_SERVICE=ollama

# [조건부 필수] Ollama 사용 시 기본 주소
# 로컬 예시: http://localhost:11434
# 배포 예시: https://ollama.example.com
OLLAMA_BASE_URL=http://localhost:11434

# [선택] Ollama API 경로 (프록시 경로 포함 가능)
OLLAMA_API_PATH=/api/chat

# [선택] Ollama SSL 인증서 검증 여부 (개발 false / 운영 true 권장)
OLLAMA_SSL_VERIFY=false

# ------------------------------------------
# 컨텍스트/요약 설정 (LLM 대화 메모리)
# ------------------------------------------
# [선택] 최근 대화 턴 수 (1턴=user+assistant 1쌍)
CONTEXT_WINDOW_TURNS=3

# [선택] 최대 컨텍스트 토큰 수
CONTEXT_MAX_TOKENS=4000

# [선택] 요약 트리거 임계치 비율 (0~1)
CONTEXT_TOKEN_THRESHOLD_RATIO=0.75

# ------------------------------------------
# GPT-SoVITS TTS API 설정
# ------------------------------------------
# [조건부 필수] TTS 기능 사용 시 GPT-SoVITS TTS API 기본 주소
# 로컬 docker 직접 접근 예시: http://localhost:9880
# 배포 프록시 예시: https://tts.example.com
TTS_BASE_URL=http://localhost:9880

# [선택] TTS API 경로 (프록시 경로 포함 가능)
TTS_API_PATH=tts

# [선택] TTS 요청 타임아웃(초)
TTS_TIMEOUT=120.0

# [선택] 생성 요청 텍스트 길이 제한(문자수)
TTS_MAX_TEXT_LENGTH=10000

# [선택] 생성 오디오 파일 최대 크기(바이트)
TTS_MAX_FILE_SIZE=52428800

# [선택] TTS SSL 인증서 검증 여부 (개발 false / 운영 true 권장)
TTS_SSL_VERIFY=false

# ------------------------------------------
# Server A (GPT-SoVITS 자동화 API) 연결 설정
# ------------------------------------------
# [조건부 필수] 모델/파일 조회 API (file_scanner_api, 기본 포트 10001)
# 로컬 예시: http://localhost:10001
# 배포 예시: https://files.example.com
SERVER_A_FILES_API_URL=http://localhost:10001

# [조건부 필수] 학습 API (training_api, 기본 포트 10002)
# 로컬 예시: http://localhost:10002
# 배포 예시: https://train.example.com
SERVER_A_TRAINING_API_URL=http://localhost:10002

# [선택] 운영 모드 표기용 (문서/로깅 용도)
# 값 예시: docker | host
SERVER_A_STACK_MODE=

# ------------------------------------------
# Server A 로컬 파일 경로 (업로드/삭제/로그 조회용)
# ------------------------------------------
# [조건부 필수] model-make/voice 관리 기능 사용 시 실제 서버 경로와 일치해야 함
# Host/Conda 예시: /opt/GPT-SoVITS/sample_train_voice
# Docker compose 연동 시 루트 compose가 /workspace/GPT-SoVITS/... 로 override 가능
SERVER_A_TRAIN_VOICE_ROOT=/opt/GPT-SoVITS/sample_train_voice

# [조건부 필수] 학습 로그 루트 경로
SERVER_A_LOGS_ROOT=/opt/GPT-SoVITS/logs

# [조건부 필수] 학습 중간 TEMP 경로
SERVER_A_TEMP_ROOT=/opt/GPT-SoVITS/TEMP

# ------------------------------------------
# 파일 저장 경로 (Backend 로컬 자산)
# ------------------------------------------
# [조건부 필수] 공유 모델 저장 디렉터리
SHARED_MODELS_DIR=./shared_models_mock

# [조건부 필수] 사용자 업로드 자산 디렉터리
USER_ASSETS_DIR=./user_assets_mock

# [선택] 프론트 preset 캐릭터 JSON 경로 (app/api/characters.py에서 직접 참조)
# Docker Compose에서는 /app/preset_characters 로 주입됨
PRESET_CHARACTERS_DIR=

# ------------------------------------------
# Redis / TTS Queue / Stream
# ------------------------------------------
# [조건부 필수] 큐/스트리밍 기능 사용 시 Redis 연결 URL
# 로컬 예시: redis://localhost:6379/0
# Docker 예시: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# [선택] TTS 작업 큐 최대 길이
TTS_QUEUE_MAX_SIZE=100

# [선택] TTS 작업 타임아웃(초)
TTS_QUEUE_JOB_TIMEOUT=60

# [선택] TTS 결과 보관 시간(초)
TTS_RESULT_TTL=300

# ------------------------------------------
# 관리자/운영 보조 옵션
# ------------------------------------------
# [선택] 관리자 이메일 목록 (쉼표 구분)
ADMIN_EMAILS=

# ==========================================
# 참고
# ==========================================
# 보안 정책:
# - Gemini 비밀키는 madcamp-Screening-Humanity-BACK/.env 의 GEMINI_API_KEY로만 관리
# - NEXT_PUBLIC_GEMINI_API_KEY fallback은 제거됨(사용 금지)
# 1) Docker Compose 루트 파일이 아래 값을 override할 수 있음:
#    - SERVER_A_FILES_API_URL
#    - SERVER_A_TRAINING_API_URL
#    - TTS_BASE_URL
# 2) 로컬 uvicorn 실행 시에는 이 .env 값이 그대로 사용됩니다.
